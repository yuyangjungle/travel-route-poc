# M9 server-only configuration. Set actual values in process/deployment secrets.
# This file is an example; the application does not automatically load .env.
# Never add API keys to web/assets, browser storage, source control, or logs.
# Manual input and fixed examples work without a model key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Web entrypoint only: false disables /api/intent while keeping manual search.
AI_ENABLED=true

# Optional legacy M7/v1 Streamlit fallback and frozen M8 evaluation only.
# M9 Web does not read these values; the v1 reliability result remains C.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
